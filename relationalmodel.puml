@startuml
!theme plain
title Modelo Entidad-Relación - KuenteCO

' ===============================
' ENTIDADES PRINCIPALES
' ===============================

entity "Usuario del Sistema" as KuentecoUser {
  * **id** : string <<PK>>
  --
  * email : string <<UNIQUE>>
  * password : string
  * state : enum
  * type : enum  
  * username : string <<UNIQUE>>
  * version : integer
}

entity "Perfil" as Profile {
  * **id** : integer <<PK>>
  --
  * email : string <<UNIQUE>>
  * password : string
  * start_date : timestamp
  * username : string
}

entity "Rol" as Role {
  * **id** : integer <<PK>>
  --
  * name : enum
}

entity "Imagen" as Image {
  * **id** : integer <<PK>>
  --
  * image_id : string
  * image_url : string
  * name : string
}

' ===============================
' ENTIDADES FINANCIERAS
' ===============================

entity "Presupuesto" as Budget {
  * **id** : integer <<PK>>
  --
  * name : string
  * remaining_budget : decimal
  * total_budget : decimal
}

entity "Categoría" as Category {
  * **id** : integer <<PK>>
  --
  * description : jsonb
  * name : string
  * register_date : LocalDateTime
}

entity "Transacción" as Transaction {
  * **id** : integer <<PK>>
  --
  * amount : decimal
  * description : jsonb
  * name : string
  * transaction_date : LocalDateTime
}

entity "Deuda" as Debt {
  * **id** : integer <<PK>>
  --
  * expiration_date : LocalDateTime
  * name : string
  * pending_amount : decimal
  * start_date : LocalDateTime
  * state : enum
  * total_amount : decimal
}

' ===============================
' ENTIDADES DE INSCRIPCIÓN
' ===============================

entity "Inscripción a Presupuesto" as BudgetEnrollment {
  * **id** : integer <<PK>>
  --
  * enrollment_date : LocalDateTime
}

entity "Inscripción a Categoría" as CategoryEnrollment {
  * **id** : integer <<PK>>
  --
  * enrollment_date : LocalDateTime
}

entity "Inscripción a Deuda" as DebtEnrollment {
  * **id** : integer <<PK>>
  --
  * enrollment_date : LocalDateTime
}

' ===============================
' SISTEMA DE NOTIFICACIONES
' ===============================

entity "Notificación" as Notification {
  * **id** : integer <<PK>>
  --
  * content : jsonb
  * date_send : LocalDateTime
  * title : string
}

' ===============================
' SISTEMA DE TIPOS DE CAMBIO
' ===============================

entity "Tasa de Cambio" as ExchangeRate {
  * **id** : integer <<PK>>
  --
  * base_currency : string
  * last_updated : timestamp
  * rate : decimal
  * target_currency : string
}

entity "Logs de Tasa de Cambio" as ExchangeRateLogs {
  * **id** : integer <<PK>>
  --
  * log_message : text
  * log_timestamp : timestamp
}

' ===============================
' SISTEMA DE PAGOS
' ===============================

entity "Pre-aprobación MercadoPago" as MercadoPagoPreapproval {
  * **id** : integer <<PK>>
  --
  * auto_recurring_currency_id : string
  * auto_recurring_frequency : integer
  * auto_recurring_frequency_type : string
  * auto_recurring_transaction_amount : decimal
  * back_url : string
  * card_brand : string
  * card_last_four_digits : string
  * date_created : LocalDateTime
  * external_reference : string
  * init_point : string
  * last_modified : LocalDateTime
  * next_payment_date : LocalDateTime
  * payer_email : string
  * payment_method_id : string
  * preapproval_id : string <<UNIQUE>>
  * reason : string
  * status : enum
}

entity "Pago MercadoPago" as MercadoPagoPayment {
  * **id** : integer <<PK>>
  --
  * authorization_code : string
  * currency_id : string
  * date_approved : LocalDateTime
  * date_created : LocalDateTime
  * date_last_updated : LocalDateTime
  * description : string
  * external_reference : string
  * payment_id : string <<UNIQUE>>
  * payment_method_id : string
  * payment_type_id : string
  * status : enum
  * status_detail : string
  * transaction_amount : decimal
}

entity "Suscripción" as Subscription {
  * **id** : integer <<PK>>
  --
  * created_at : LocalDateTime
  * expiration_date : LocalDateTime
  * is_auto_renewable : boolean
  * start_date : LocalDateTime
  * state : enum
  * type : enum
  * updated_at : LocalDateTime
}

' ===============================
' INTEGRACIÓN BANCARIA
' ===============================

entity "Token Bancolombia" as BancolombiaToken {
  * **id** : bigint <<PK>>
  --
  * access_token : text
  * created_at : LocalDateTime
  * expires_at : LocalDateTime
  * expires_in : bigint
  * is_active : boolean
  * refresh_token : text
  * scope : string
  * token_type : string
}

' ===============================
' SISTEMA DE AUDITORÍA
' ===============================

entity "Logs de Auditoría" as AuditLogs {
  * **id** : integer <<PK>>
  --
  * table_name : string
  * operation : string
  * record_id : integer
  * log_message : text
  * log_timestamp : timestamp
}

' ===============================
' RELACIONES PRINCIPALES
' ===============================

' Relaciones de Usuario
KuentecoUser ||--o{ Profile : "tiene"
KuentecoUser ||--o| Image : "tiene imagen"
KuentecoUser }o--|| Role : "asignado a"

' Relaciones de Perfil
Profile ||--o| Image : "tiene imagen"
Profile }o--|| Role : "asignado a"

' Relaciones Financieras
KuentecoUser ||--o{ Budget : "crea"
KuentecoUser ||--o{ Category : "gestiona"
KuentecoUser ||--o{ Debt : "posee"
KuentecoUser ||--o{ Transaction : "registra"

Budget ||--o{ Category : "contiene"
Budget ||--o{ Transaction : "rastrea gastos"
Category ||--o{ Transaction : "clasifica"
Debt ||--o{ Transaction : "pagos de"

Profile ||--o{ Transaction : "ejecuta"

' Relaciones de Inscripción
Budget ||--o{ BudgetEnrollment : "inscripciones"
Category ||--o{ CategoryEnrollment : "inscripciones"
Debt ||--o{ DebtEnrollment : "inscripciones"
Profile ||--o{ BudgetEnrollment : "inscrito en"
Profile ||--o{ CategoryEnrollment : "inscrito en"
Profile ||--o{ DebtEnrollment : "inscrito en"
KuentecoUser ||--o{ BudgetEnrollment : "gestiona"
KuentecoUser ||--o{ CategoryEnrollment : "gestiona"
KuentecoUser ||--o{ DebtEnrollment : "gestiona"

' Relaciones de Notificaciones
KuentecoUser ||--o{ Notification : "recibe"
Profile ||--o{ Notification : "dirigidas a"

' Relaciones de Pagos
KuentecoUser ||--o{ MercadoPagoPreapproval : "posee"
MercadoPagoPreapproval ||--o{ MercadoPagoPayment : "genera"
MercadoPagoPreapproval ||--o| Subscription : "habilita"
KuentecoUser ||--o{ Subscription : "suscrito a"

' ===============================
' RESTRICCIONES Y NOTAS
' ===============================

note top of ExchangeRate : Combinación única de\nbase_currency + target_currency

note bottom of KuentecoUser : Entidad central del sistema.\nGestiona todos los aspectos financieros

note right of Transaction : Registra todos los movimientos\nfinancieros del usuario

note left of BudgetEnrollment : Permite colaboración\nen presupuestos

note bottom of MercadoPagoPreapproval : Integración con MercadoPago\npara pagos recurrentes

@enduml
